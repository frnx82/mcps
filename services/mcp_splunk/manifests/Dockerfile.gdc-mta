# Build a GDC-compatible image from the existing MTA image.
# Fixes file permissions so non-root UID (1000) can read all files
# and write to runtime directories.
FROM <JAMES_IMAGE>

USER root

# Make EVERYTHING under the app directory readable AND writable by UID 1000.
# This covers:
#   - conf/, lib/, bin/ (read: 660 → 755)
#   - var/, log/, sieve, and any other runtime dirs James creates
RUN chown -R 1000:1000 /deployments/james-server-app-3.6.1/ \
 && chmod -R u+rwX /deployments/james-server-app-3.6.1/ \
 && chmod +x /deployments/james-server-app-3.6.1/bin/*.sh \
             /deployments/james-server-app-3.6.1/conf/*.sh 2>/dev/null || true

# Pre-create known runtime directories
RUN mkdir -p /deployments/james-server-app-3.6.1/sieve \
             /deployments/james-server-app-3.6.1/var/store/activemq/brokers \
             /deployments/james-server-app-3.6.1/var/store/derby \
             /deployments/james-server-app-3.6.1/var/store/lucene \
             /deployments/james-server-app-3.6.1/var/mail \
             /deployments/james-server-app-3.6.1/log \
 && chown -R 1000:1000 /deployments/james-server-app-3.6.1/sieve \
                       /deployments/james-server-app-3.6.1/var \
                       /deployments/james-server-app-3.6.1/log
# Force wrapper to run in FOREGROUND (console) mode.
# Without this, the wrapper forks to background, PID 1 exits,
# and Kubernetes stops the container (exit code 0, "Completed").
RUN echo "" >> /deployments/james-server-app-3.6.1/conf/wrapper.conf \
 && echo "# GDC fix: prevent daemon mode so container stays alive" >> /deployments/james-server-app-3.6.1/conf/wrapper.conf \
 && echo "wrapper.daemonize=FALSE" >> /deployments/james-server-app-3.6.1/conf/wrapper.conf

# Switch back to non-root for GDC compliance
USER 1000
