    },
    {
      "id": "phase3-tasks", "type": "text", "x": 555, "y": 140, "width": 190, "height": 200,
      "text": "✔️ Verify commit history\n    matches CVS\n\n✔️ Compare file counts\n    and integrity\n\n📚 Developer training\n    (2-3 workshops)\n\n👥 Pilot team (5-8 devs)\n    works in GitHub\n\n📖 Document new Git\n    workflows for DEP\n\n🧪 Test CI/CD builds\n    end-to-end",
      "fontSize": 12, "fontFamily": 1, "textAlign": "left",
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "roughness": 1, "opacity": 100, "angle": 0,
