    },
    {
      "id": "phase4-tasks", "type": "text", "x": 810, "y": 140, "width": 190, "height": 200,
      "text": "🔄 Final CVS sync\n    (last commits)\n\n🔒 Set CVS to\n    READ-ONLY\n\n📢 Announce cutover\n    to all developers\n\n🚀 All development\n    moves to GitHub\n\n📁 Keep CVS archive\n    for 6-12 months\n\n🎉 GO LIVE!",
      "fontSize": 12, "fontFamily": 1, "textAlign": "left",
